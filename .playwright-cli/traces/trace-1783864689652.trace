n          - tablist [ref=f9e408]:\n            - tab \"Usage\" [ref=f9e409] [cursor=pointer]\n            - tab \"Examples\" [ref=f9e410] [cursor=pointer]\n            - tab \"Structure\" [ref=f9e411] [cursor=pointer]\n          - generic [ref=f9e412]:\n            - generic [ref=f9e414]:\n              - generic [ref=f9e415]:\n                - heading \"Basic Gallery\" [level=2] [ref=f9e416]\n                - paragraph [ref=f9e417]: Wrap any image grid. Each descendant image becomes a zoom trigger.\n              - generic [ref=f9e418]:\n                - generic [ref=f9e422]:\n                  - 'button \"Open image gallery: Desert road with sandstone formations\" [ref=f9e639]'\n                  - 'button \"Open image gallery: Clear turquoise ocean water at a beach\" [ref=f9e640]'\n                  - 'button \"Open image gallery: Night sky over snowy mountains\" [ref=f9e641]'\n                - generic [ref=f9e428]:\n                  - generic [ref=f9e431]:\n                    - button \"Copy\" [ref=f9e433] [cursor=pointer]\n                    - group \"Scrollable content\" [ref=f9e437]:\n                      - code [ref=f9e441]:\n                        - generic [ref=f9e442]: <ImageGallery>\n                        - generic [ref=f9e443]: <div class=\"grid grid-cols-3 gap-3\">\n                        - generic [ref=f9e444]: <img src=\"/desert-road.jpg\" alt=\"Desert road\" title=\"Desert road\" />\n                        - generic [ref=f9e445]: <img src=\"/clear-water.jpg\" alt=\"Clear ocean water\" title=\"Clear ocean water\" />\n                        - generic [ref=f9e446]: <img src=\"/night-sky.jpg\" alt=\"Night sky\" title=\"Night sky\" />\n                        - generic [ref=f9e447]: </div>\n                        - generic [ref=f9e448]: </ImageGallery>\n                  - button \"View code\" [ref=f9e449]\n            - table [ref=f9e456]:\n              - rowgroup [ref=f9e457]:\n                - row [ref=f9e458]:\n                  - columnheader [ref=f9e459]\n                - row [ref=f9e463]:\n                  - cell \"buttonLabel\" [ref=f9e464]\n                  - cell [ref=f9e467]:\n                    - code [ref=f9e468]: string\n                  - cell \"Accessible label applied to enhanced image triggers.\" [ref=f9e469]\n                - row [ref=f9e470]:\n                  - cell \"class\" [ref=f9e471]\n                  - cell [ref=f9e474]:\n                    - code [ref=f9e475]: string\n                  - cell \"Additional CSS classes merged onto the root element.\" [ref=f9e476]\n                - row [ref=f9e477]:\n                  - cell \"closeLabel\" [ref=f9e478]\n                  - cell [ref=f9e481]:\n                    - code [ref=f9e482]: string\n                  - cell \"Accessible label for the close button.\" [ref=f9e483]\n                - row [ref=f9e484]:\n                  - cell \"closeOnClickOutside\" [ref=f9e485]\n                  - cell [ref=f9e488]:\n                    - code [ref=f9e489]: boolean\n                  - cell \"When true, clicking the backdrop closes the zoomed gallery.\" [ref=f9e490]\n                - row [ref=f9e491]:\n                  - cell \"closeOnEscape\" [ref=f9e492]\n                  - cell [ref=f9e495]:\n                    - code [ref=f9e496]: boolean\n                  - cell \"When true, pressing Escape closes the zoomed gallery.\" [ref=f9e497]\n                - row [ref=f9e498]:\n                  - cell \"disabled\" [ref=f9e499]\n                  - cell [ref=f9e502]:\n                    - code [ref=f9e503]: boolean\n                  - cell \"When true, descendant images are not enhanced.\" [ref=f9e504]\n                - row [ref=f9e505]:\n                  - cell \"id\" [ref=f9e506]\n                  - cell [ref=f9e509]:\n                    - code [ref=f9e510]: string\n                  - cell \"Stable DOM id for the zoom dialog root; falls back to a generated id.\" [ref=f9e511]\n                - row [ref=f9e512]:\